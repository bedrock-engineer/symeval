# Python
__pycache__/
*.py[cod]
*.egg-info/

# Build & packaging (uv build -> dist/)
build/
dist/

# Virtual environment
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# marimo
__marimo__/
marimo/_static/
marimo/_lsp/

# Quarto docs site
# (.quarto/ and *.quarto_ipynb are ignored by docs/.gitignore, which Quarto manages)
/docs/_site/
/docs/*.html
/docs/examples/*.html
/docs/**/*_files/
/docs/libs/
/docs/_extensions/**/marimo-engine-v*.js

# Coding agents
# Keeps agent scratch and git worktrees (e.g. .claude/worktrees/) out of history.
.opencode/
.claude/
.codex/
.cursor/
.continue/
.windsurf/
.llm/
.ai/

# OS
.DS_Store
