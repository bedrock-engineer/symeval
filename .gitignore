# Python
__pycache__/
*.py[cod]
*.egg-info/

# Build & packaging (uv build -> dist/)
build/
dist/

# Virtual environment
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# marimo
__marimo__/
marimo/_static/
marimo/_lsp/

# Node tooling for README GIFs (media/). The generated GIFs live in
# docs/assets/gifs/ and ARE committed; only deps and scratch frames are ignored.
node_modules/
/media/tmp/

# Quarto docs site
# (.quarto/ and *.quarto_ipynb are ignored by docs/.gitignore, which Quarto manages)
/docs/_site/
/docs/*.html
/docs/examples/*.html
/docs/**/*_files/
/docs/libs/
# quarto-marimo's marimo-engine.js is a loader shim that downloads these
# versioned artifacts from the GitHub release on first render.
/docs/_extensions/**/marimo-engine-v*.js
/docs/_extensions/**/browser-v*.js
/docs/_extensions/**/assets/

# Coding agents
# Keeps agent scratch and git worktrees (e.g. .claude/worktrees/) out of history.
.opencode/
.claude/
.codex/
.cursor/
.continue/
.windsurf/
.llm/
.ai/

# OS
.DS_Store
